# Records kept off the published site entirely (test photos, anywhere outside
# the survey area), and their thumbnails. thumbs/ is tracked so the deploy runner
# can publish images, so local-only thumbnails need their own untracked home.
data/observations-local.json
thumbs-local/
# Record of what's already on R2 — local bookkeeping, rebuilt on demand.
data/r2-manifest.json
